flowchart LR
    subgraph Offline["Offline catalog build (scripts/build_real_catalog.py)"]
        Deezer[("Deezer public API<br/>playlists, tracks, covers")] --> Collect["Seed searches → labelled tracks<br/>playlist titles become tags"]
        Collect --> Measure["Download 30 s preview once<br/>librosa: tempo, energy, audio proxies"]
        Measure --> RealCSV[("data/real_songs.csv")]
    end
    RealCSV --> Embed["Embed song documents<br/>Hugging Face all-MiniLM-L6-v2 (local)"]
    Embed --> Index[("Embedding index")]

    User --> Request["Natural-language request"]
    Request --> Retrieve["RAG: retrieve closest songs"]
    Index --> Retrieve
    Retrieve -- "catalog_matches (hints)" --> Planner["LLM planner<br/>structured JSON only"]
    Request --> Planner
    Profile[("Local JSON profile<br/>one per catalog")] --> Planner
    Planner --> Plan["Validated recommendation plan"]
    Plan --> Orchestrator["Python Plan → Act → Observe → Revise<br/>bounded to configured attempts"]
    RealCSV --> Filter["Hard-constraint filter"]
    Orchestrator --> Filter --> Narrow["RAG: top-k eligible by similarity<br/>fallback: all eligible"]
    Index --> Narrow
    Narrow --> VibeMatch["Original VibeMatch scorer<br/>unchanged"]
    VibeMatch --> Builder["Playlist builder"]
    Builder --> Validator{"Deterministic validator"}
    Validator -- valid --> Playlist["Catalog-backed playlist"]
    Validator -- retryable --> Observation["Structured failure observation"]
    Observation --> Planner
    Validator -- unsupported / impossible / budget exhausted --> Status["Explicit failure status"]
    Playlist --> Web["Web page: cover cards<br/>▶ fresh 30 s Deezer preview"]
    Deezer -. "preview URL on click" .-> Web
    Web --> User
    Status --> User
    User --> Feedback["Like / dislike / skip"]
    Feedback --> Profile
    Orchestrator -.-> Logs[("JSON workflow events<br/>stderr")]
    Logs --> Evaluation["Mock evaluation + RAG retrieval evaluation"]
